digraph CityVeins {
    graph [
        rankdir=TB,
        fontsize=10,
        fontname="Arial",
        splines=ortho,
        nodesep=0.6,
        ranksep=0.8
    ];

    node [
        shape=box,
        style=rounded,
        fontname="Arial",
        fontsize=9
    ];

    edge [
        fontname="Arial",
        fontsize=8,
        arrowsize=0.8
    ];

    // 数据输入节点
    "高德地图API" [shape=cylinder, fillcolor=lightblue, style=filled];
    "行政区名称" [shape=note, fillcolor=lightyellow, style=filled];
    "key.txt" [shape=document, fillcolor=lightgrey, style=filled];
    "高德POI分类编码" [shape=document, fillcolor=lightgrey, style=filled];
    "POI权重配置" [shape=document, fillcolor=lightgrey, style=filled];

    // 主要处理模块
    subgraph cluster_1 {
        label="数据准备阶段";
        color=blue;
        style=filled;
        fillcolor=lightcyan;

        "validate_district" [shape=diamond, label="验证行政区名称", fillcolor=lightyellow];
        "get_district_boundary" [label="获取行政区边界"];
        "boundary_data" [shape=cylinder, label="行政区边界数据", fillcolor=lightblue, style=filled];

        "validate_district" -> "get_district_boundary" [label="验证通过"];
        "get_district_boundary" -> "boundary_data";
    }

    subgraph cluster_2 {
        label="POI数据获取";
        color=red;
        style=filled;
        fillcolor=lightpink;

        "get_residential_areas" [label="get_residential_areas.py
获取住宅区数据"];
        "residential_data" [shape=cylinder, label="住宅区数据
(residential_*.csv)", fillcolor=lightblue, style=filled];
        "get_single_residential_poi" [label="get_single_residential_poi.py
获取单个住宅区POI数据"];
        "get_batch_residential_poi" [label="get_batch_residential_poi.py
批量获取POI数据"];
        "poi_data" [shape=cylinder, label="POI数据
(poi_*.csv, poi_*.json)", fillcolor=lightblue, style=filled];
        "poi_stats" [shape=cylinder, label="POI统计信息
(poi_stats_*.csv, poi_stats_*.json)", fillcolor=lightblue, style=filled];
        "processing_summary" [shape=cylinder, label="处理摘要
(processing_summary.csv)", fillcolor=lightblue, style=filled];
        "failed_records" [shape=cylinder, label="失败记录
(failed_records.csv)", fillcolor=lightblue, style=filled];

        "get_residential_areas" -> "residential_data";
        "residential_data" -> "get_batch_residential_poi";
        "get_batch_residential_poi" -> "get_single_residential_poi" [label="调用"];
        "get_single_residential_poi" -> "poi_data";
        "get_single_residential_poi" -> "poi_stats";
        "get_batch_residential_poi" -> "processing_summary";
        "get_batch_residential_poi" -> "failed_records";
    }

    subgraph cluster_3 {
        label="POI数据处理与分析";
        color=purple;
        style=filled;
        fillcolor=lavender;

        "poi_analyzer" [label="get_batch_residential_poi.py
分析POI处理结果"];
        "poi_processor" [label="utils/poi_processor.py
POI数据处理与统计"];
        "processed_poi" [shape=cylinder, label="处理后的POI数据", fillcolor=lightblue, style=filled];

        "poi_data" -> "poi_analyzer";
        "processing_summary" -> "poi_analyzer";
        "failed_records" -> "poi_analyzer";
        "poi_data" -> "poi_processor";
        "poi_processor" -> "processed_poi";
    }

    subgraph cluster_4 {
        label="评分计算";
        color=orange;
        style=filled;
        fillcolor=moccasin;

        "calculate_batch_scores" [label="calculate_batch_scores.py
批量计算评分"];
        "calculate_single_score" [label="calculate_single_score.py
单个住宅区评分"];
        "scores" [shape=cylinder, label="评分结果
(scores_*.csv)", fillcolor=lightblue, style=filled];
        "stats" [shape=cylinder, label="分类统计
(stats_*.csv)", fillcolor=lightblue, style=filled];

        "processed_poi" -> "calculate_batch_scores";
        "calculate_batch_scores" -> "calculate_single_score" [label="调用"];
        "calculate_single_score" -> "scores";
        "calculate_single_score" -> "stats";
    }

    subgraph cluster_5 {
        label="输出与可视化";
        color=green;
        style=filled;
        fillcolor=lightgreen;

        "generate_report" [label="生成评估报告"];
        "visualization" [label="数据可视化"];
        "final_report" [shape=document, label="最终评估报告
(Markdown/PDF)", fillcolor=lightgrey, style=filled];
        "charts" [shape=document, label="可视化图表", fillcolor=lightgrey, style=filled];

        "scores" -> "generate_report";
        "stats" -> "generate_report";
        "generate_report" -> "final_report";
        "scores" -> "visualization";
        "stats" -> "visualization";
        "visualization" -> "charts";
    }

    // 数据输入到处理模块的连接
    "行政区名称" -> "validate_district";
    "高德地图API" -> "get_district_boundary";
    "高德地图API" -> "get_single_residential_poi";
    "key.txt" -> "get_single_residential_poi";
    "高德POI分类编码" -> "get_single_residential_poi";
    "POI权重配置" -> "calculate_single_score";

    // 主流程连接
    "boundary_data" -> "get_residential_areas";
}
